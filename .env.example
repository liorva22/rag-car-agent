# 1 = extractive mock answers (retrieval is still real), no key needed. 0 = Claude writes cited answers.
MOCK_MODE=1
# Required only when MOCK_MODE=0.
ANTHROPIC_API_KEY=
# Model that writes answers in live mode.
ANSWER_MODEL=claude-sonnet-5-5
# Postgres DSN (pgvector). docker compose sets this for the containers.
DATABASE_URL=postgresql://car:car@localhost:5438/car
# Host ports under docker compose.
DB_PORT=5438
APP_PORT=8106
